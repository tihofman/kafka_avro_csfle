# Kopieren nach .env (ist in .gitignore, NICHT committen).
#
# Confluent Cloud Zugangsdaten (Kafka-Cluster + Schema Registry).
# Quelle: Confluent Cloud Console -> Cluster/Schema Registry -> API Keys erstellen.
CC_BOOTSTRAP_SERVERS=
CC_API_KEY=
CC_API_SECRET=
CC_SCHEMA_REGISTRY_URL=
CC_SCHEMA_REGISTRY_API_KEY=
CC_SCHEMA_REGISTRY_API_SECRET=

# HashiCorp Vault (laeuft lokal via docker-compose)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root-token
